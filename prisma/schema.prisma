// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// CORE CURRICULUM TABLES
// ============================================================

// Steps (Chapters) - e.g., "Step 1: Learn the basics"
model Step {
  id          Int       @id @default(autoincrement())
  stepNumber  Int       @unique
  title       String
  description String?
  slug        String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  topics Topic[]

  @@map("steps")
}

// Topics - e.g., "User Input / Output", "Data Types"
model Topic {
  id          Int      @id @default(autoincrement())
  stepId      Int
  topicNumber Int
  title       String
  slug        String   @unique
  difficulty  String   @default("EASY") // EASY, MEDIUM, HARD
  createdAt   DateTime @default(now())

  // Relations
  step     Step      @relation(fields: [stepId], references: [id], onDelete: Cascade)
  problems Problem[]

  @@unique([stepId, topicNumber])
  @@map("topics")
}

// Problems
model Problem {
  id             Int      @id @default(autoincrement())
  topicId        Int
  problemNumber  Int      @unique
  title          String
  slug           String   @unique
  difficulty     String   // EASY, MEDIUM, HARD
  description    String
  examples       Json     // [{input, output, explanation}]
  constraints    Json     // [{text}]
  hints          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  topic         Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  learnContent  LearnContent?
  testCases     TestCase[]
  submissions   Submission[]
  userProgress  UserProgress[]

  @@map("problems")
}

// ============================================================
// LEARN MODE TABLES
// ============================================================

// Learn Mode Content
model LearnContent {
  id              Int      @id @default(autoincrement())
  problemId       Int      @unique
  concept         String   // What concept is involved
  whyExists       String   // Why it exists
  whenToUse       String   // When to use
  identification  String   // How to identify such problems
  approach        String   // How to approach solving
  commonMistakes  String?  // Common mistakes
  complexity      String   // Complexity analysis
  examples        Json?    // Example walkthroughs
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@map("learn_content")
}

// Test Cases
model TestCase {
  id             Int      @id @default(autoincrement())
  problemId      Int
  caseNumber     Int
  input          String
  expectedOutput String
  isHidden       Boolean  @default(false) // Hidden test cases
  createdAt      DateTime @default(now())

  // Relations
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, caseNumber])
  @@map("test_cases")
}

// ============================================================
// USER & AUTH TABLES
// ============================================================

// Users table
model User {
  id                String              @id @default(cuid())
  name              String?
  email             String?             @unique
  emailVerified     DateTime?
  image             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  accounts          Account[]
  sessions          Session[]
  submissions       Submission[]
  userProgress      UserProgress[]
  roadmapProgress   UserRoadmapProgress?

  @@map("users")
}

// NextAuth.js tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// SUBMISSION & PROGRESS TABLES
// ============================================================

// User Submissions
model Submission {
  id               String   @id @default(cuid())
  userId           String
  problemId        Int
  code             String
  language         String   @default("java")
  status           String   // PENDING, ACCEPTED, WRONG_ANSWER, TLE, CE, RE
  executionTime    Int?     // milliseconds
  memoryUsed       Int?     // kilobytes
  testCasesPassed  Int?
  totalTestCases   Int?
  submittedAt      DateTime @default(now())

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([problemId])
  @@index([status])
  @@map("submissions")
}

// User Progress
model UserProgress {
  id            Int       @id @default(autoincrement())
  userId        String
  problemId     Int
  status        String    @default("NOT_STARTED") // NOT_STARTED, ATTEMPTED, SOLVED
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  solvedAt      DateTime?

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId])
  @@map("user_progress")
}

// User Roadmap Progress (aggregated)
model UserRoadmapProgress {
  id              Int      @id @default(autoincrement())
  userId          String   @unique
  totalProblems   Int      @default(0)
  solvedProblems  Int      @default(0)
  lastActivity    DateTime @default(now())
  createdAt       DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_roadmap_progress")
}
