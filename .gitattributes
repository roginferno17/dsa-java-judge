# Normalise line endings so the repo behaves the same on both machines.
* text=auto

# Shell scripts MUST stay LF. With core.autocrlf=true (the Windows default) a
# CRLF checkout makes bash fail with:  $'\r': command not found
*.sh text eol=lf

# Batch files are the mirror case: they need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Source kept as LF so diffs stay clean across machines.
*.ts   text eol=lf
*.tsx  text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.java text eol=lf
*.md   text eol=lf

# Binary assets: never touch.
*.png binary
*.jpg binary
*.ico binary
*.svg text eol=lf
